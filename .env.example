# ===== Runtime =====
NODE_ENV=development
PORT=3000

# ===== Database =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_work_coach

# ===== Local Dev Mode (set true to bypass Feishu SSO) =====
LOCAL_DEV=true
VITE_LOCAL_DEV=true
DEV_USER_ID=local-dev-user
DEV_USER_NAME=local-user
DEV_USER_EMAIL=dev@local.com

# ===== AI Configuration (豆包 AI) =====
# AI Provider: openai | platform (openai = 豆包/OpenAI兼容接口)
AI_PROVIDER=openai
# 豆包 AI API Key（必填）
DOUBAO_API_KEY=
# 豆包 AI Base URL（可选，默认 OpenAI 兼容地址）
DOUBAO_BASE_URL=https://api.openai.com/v1
# 豆包 AI 模型（可选，默认 gpt-4o-mini）
DOUBAO_MODEL=gpt-4o-mini
# 兼容旧变量（如已设置 OPENAI_* 可继续使用）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# ===== File Upload =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ===== Feishu SSO (required when LOCAL_DEV=false) =====
# LARK_APP_ID=
# LARK_APP_SECRET=
