# ===== Runtime =====
NODE_ENV=development
PORT=3000

# ===== Database =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_work_coach

# ===== Local Dev Mode (set true to bypass Feishu SSO) =====
LOCAL_DEV=true
VITE_LOCAL_DEV=true
DEV_USER_ID=local-dev-user
DEV_USER_NAME=local-user
DEV_USER_EMAIL=dev@local.com

# ===== AI Configuration (豆包 AI) =====
# AI Provider: openai | platform (openai = 豆包/OpenAI兼容接口)
AI_PROVIDER=openai
# 豆包 AI API Key（必填，在火山引擎方舟控制台获取）
DOUBAO_API_KEY=
# 豆包 AI Base URL
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 豆包 AI 模型（可根据实际账号支持的模型进行切换）
# AI 顾问优先使用低延迟模型，以下为推荐的轻量模型（需在方舟控制台激活）：
#   doubao-seed-2-0-mini-260428  — 轻量快速，适合日常对话
#   doubao-seed-2-0-lite-260428  — 更轻量，响应最快
#   doubao-seed-2-1-pro-260628   — Pro模型，质量高但首Token较慢（30-50秒）
DOUBAO_MODEL=doubao-seed-2-0-mini-260428
# 兼容旧变量（如已设置 OPENAI_* 可继续使用）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# ===== File Upload =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ===== Feishu SSO (required when LOCAL_DEV=false) =====
# LARK_APP_ID=
# LARK_APP_SECRET=
